{
  "manifest_version": 3,
  "name": "BetterMykoob",
  "description": "Современная оболочка для Mykoob",
  "version": "0.1.1",
  "content_scripts": [
    {
      "matches": ["https://family.mykoob.lv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://family.mykoob.lv/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
