{
  "manifest_version": 3,
  "name": "BetterMykoob",
  "description": "Современная оболочка для Mykoob",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["https://family.mykoob.lv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://family.mykoob.lv/*"]
}
